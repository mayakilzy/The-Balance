# ============================================================
# The Balance — Environment Variables (EXAMPLE — no real secrets)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Application ---
NODE_ENV=development
APP_NAME="The Balance"
APP_VERSION="0.0.1"

# --- Database (PostgreSQL 16 + pgvector) ---
# Four roles (see ADR-0005 + G03-06 Trust Boundary Closure):
#   balance_app                — RLS-enforced, used by app at runtime
#   balance_admin              — BYPASSRLS, used for migrations + seed only
#   balance_auth               — read-only, column-level grants for auth bootstrap
#   balance_snapshot_approver  — G03-06 privileged role for snapshot approval
#                                (LOGIN, separate password, column-scoped UPDATE
#                                 on shared_snapshots; balance_app CANNOT SET ROLE
#                                 to it — trust boundary for institutional approvals)
# Local dev: docker-compose up postgres
DATABASE_URL="postgresql://balance_app:balance_app_dev_only@localhost:5432/balance?schema=public"
DIRECT_URL="postgresql://balance_admin:balance_admin_dev_only@localhost:5432/balance?schema=public"
AUTH_DATABASE_URL="postgresql://balance_auth:balance_auth_dev_only@localhost:5432/balance?schema=public"
PRIVILEGED_DATABASE_URL="postgresql://balance_snapshot_approver:balance_snapshot_approver_dev_only@localhost:5432/balance?schema=public"

# --- Auth (Auth.js v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
# Base URL of the deployed app
AUTH_URL="http://localhost:3000"
# Trusted host header (set to your production domain in prod)
AUTH_TRUST_HOST="true"

# --- Deployment shape (00-09 security hardening) ---
# Set to "true" ONLY when the app is deployed behind a known reverse
# proxy (nginx, Cloudflare, AWS ALB) that overwrites x-forwarded-for.
# When "false" (default), client-supplied IP headers are NEVER trusted
# and rate limits fall back to a shared bucket to prevent spoofing.
TRUSTED_PROXY="false"

# --- LLM Provider (abstraction — see src/lib/llm/) ---
# Which provider to use: "stub" (default, no real LLM) | "zai" | "openai" | "anthropic"
LLM_PROVIDER="stub"
# Provider-specific keys are loaded only when LLM_PROVIDER matches.
# Do NOT set real keys in this example file.
# ZAI_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# --- Observability ---
LOG_LEVEL="info"  # trace | debug | info | warn | error

# --- Demo ---
# Set to "true" ONLY in isolated dev/demo environments to show test credentials on login page
SHOW_DEMO_CREDENTIALS="false"
