// The Balance — Prisma Schema
// GROUP 00 Foundation
// 00-01: Tenant + AuditLog (initial)
// 00-02: Country + StateHierarchy + Institution + RoleReference + SourceRegistry + PublicKnowledge
// Future: User (00-03), Evidence+Source (00-04), Strategy+Event (00-05), Task (00-06), Capability (00-07).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // pgvector extension + RLS policies + roles are managed via raw SQL
  // migrations (see prisma/migrations/).
}

// ============================================================
// PUBLIC SCOPE — Global reference data, no tenant_id
// ============================================================

model Country {
  id          String   @id @default(cuid())
  iso3        String   @unique // "SYR", "JOR" — ISO 3166-1 alpha-3
  iso2        String?  @unique // "SY", "JO" — ISO 3166-1 alpha-2
  displayName String
  status      String   @default("active") // active | suspended | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants        Tenant[]
  stateHierarchy StateHierarchy[]
  institutions   Institution[]
  // G01 (migration 0017): tenant-scoped planning data referencing this country
  objectives         Objective[]
  countryPackConfigs CountryPackConfig[]

  @@map("countries")
  @@index([status])
}

model StateHierarchy {
  id          String   @id @default(cuid())
  countryId   String
  parentId    String? // self-reference for nesting
  code        String // "SY-DAM" for Damascus province
  displayName String
  // Level: "nation" | "province" | "district" | "municipality" | "neighborhood"
  level       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country  Country          @relation(fields: [countryId], references: [id])
  parent   StateHierarchy?  @relation("StateHierarchyTree", fields: [parentId], references: [id])
  children StateHierarchy[] @relation("StateHierarchyTree")

  @@unique([countryId, code])
  @@index([countryId, level])
  @@map("state_hierarchy")
}

model Institution {
  id          String   @id @default(cuid())
  countryId   String
  parentId    String? // self-reference for nesting
  code        String
  displayName String
  // Type: "ministry" | "agency" | "authority" | "directorate" | "council"
  type        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country  Country      @relation(fields: [countryId], references: [id])
  parent   Institution? @relation("InstitutionTree", fields: [parentId], references: [id])
  children Institution[] @relation("InstitutionTree")

  @@unique([countryId, code])
  @@map("institutions")
}

model RoleReference {
  id          String   @id @default(cuid())
  code        String   @unique // "admin", "analyst", "reviewer", "observer"
  displayName String
  description String
  // Catalog of permissions for this role (JSON Schema-like).
  permissions Json  @default("{}")
  createdAt   DateTime @default(now())

  memberships Membership[]

  @@map("role_references")
}

model SourceRegistry {
  id          String   @id @default(cuid())
  code        String   @unique // "WORLD_BANK", "IMF", "UN_STATS"
  displayName String
  // Type: "international_org" | "academic" | "government" | "media" | "ngo"
  type        String
  license     String?
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publicKnowledge PublicKnowledge[]

  @@map("source_registry")
  @@index([type])
}

model PublicKnowledge {
  id          String   @id @default(cuid())
  sourceId    String? // optional FK to SourceRegistry
  title       String
  content     String
  metadata    Json  @default("{}")
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  source SourceRegistry? @relation(fields: [sourceId], references: [id])

  @@index([title])
  @@index([publishedAt])
  @@map("public_knowledge")
}

// ============================================================
// PRIVATE SCOPE — Tenant-specific data (RLS-enforced)
// ============================================================

model Tenant {
  id          String   @id @default(cuid())
  code        String   @unique // "SY-MIN-PLAN", "SY-CB" — independent of Country.iso3
  displayName String
  countryId   String
  status      String   @default("active") // active | suspended | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country    Country       @relation(fields: [countryId], references: [id])
  auditLogs  AuditLog[]
  memberships Membership[]
  evidence    Evidence[]
  evidenceEmbeddings EvidenceEmbedding[]
  strategies  Strategy[]
  strategyVersions StrategyVersion[]
  decisions   Decision[]
  decisionEvents DecisionEvent[]
  events      Event[]
  tasks       Task[]
  taskEvents  TaskEvent[]
  capabilityInvocations CapabilityInvocation[]
  // G01 (migration 0017): tenant-scoped State Builder planning data
  objectives         Objective[]
  countryPackConfigs CountryPackConfig[]
  programs           Program[]
  projects           Project[]
  budgetLines        BudgetLine[]
  dependencies       Dependency[]
  riskRegisters      RiskRegister[]
  assumptions        Assumption[]

  @@map("tenants")
  @@index([status])
  @@index([countryId])
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now())
  // Who: tenant + actor (user id or "system")
  tenantId    String?
  actor       String   @default("system")
  // What: action verb (e.g., "tenant.create", "auth.login", "evidence.read")
  action      String
  // Where: request context
  route       String?
  method      String?
  ipHash      String? // hashed, never raw
  // Payload: structured details (JSONB). Secrets are stripped before insert.
  details     Json     @default("{}")
  // Outcome
  status      String   @default("ok") // ok | error | denied
  errorCode   String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@map("audit_log")
  @@index([tenantId, at])
  @@index([action, at])
}

// ============================================================
// IDENTITY (00-03) — User + Membership
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // Status lifecycle: active | suspended | disabled
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@map("users")
  @@index([status])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  roleCode  String
  // Status lifecycle: active | revoked
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   RoleReference @relation(fields: [roleCode], references: [code])

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
  @@map("memberships")
}

// ============================================================
// EVIDENCE FABRIC (00-04)
// ============================================================

model Source {
  id               String   @id @default(cuid())
  code             String   @unique
  displayName      String
  // Type: "international_org" | "academic" | "government" | "media" | "ngo"
  type             String
  license          String?
  url              String?
  urlHash          String?  @unique
  // Independence group: sources in the same group are NOT independent
  // (e.g., syndicated news feeds). Used for dedup + independence counting.
  independenceGroup String?
  // Review status: "candidate" (tenant-submitted, not reviewed) | "approved" (global)
  reviewStatus     String   @default("approved")
  // Which tenant submitted this candidate (null for admin-curated)
  submittedByTenantId String?
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  evidence Evidence[]

  @@index([type])
  @@index([independenceGroup])
  @@index([reviewStatus])
  @@map("sources")
}

model Evidence {
  id                String   @id @default(cuid())
  tenantId          String
  sourceId          String?
  claim             String
  summary           String?
  // Type: "supporting" | "counter" | "neutral"
  type              String   @default("neutral")
  // Links to another evidence this supports/contradicts
  relatedEvidenceId String?
  // Verification: "unverified" | "verified" | "disputed" | "refuted"
  verificationStatus String  @default("unverified")
  // Provenance: when observed vs when recorded
  observedAt        DateTime?
  retrievedAt       DateTime @default(now())
  extractionMethod  String?
  // Classification: "public" | "classified" | "restricted"
  classification    String   @default("public")
  confidenceNotes   String?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant     Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source     Source?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  relatedTo  Evidence?        @relation("EvidenceRelations", fields: [relatedEvidenceId], references: [id], onDelete: SetNull)
  relatedBy  Evidence[]       @relation("EvidenceRelations")
  embedding  EvidenceEmbedding?

  @@index([tenantId, type])
  @@index([tenantId, verificationStatus])
  @@index([tenantId, classification])
  @@index([relatedEvidenceId])
  @@map("evidence")
}

model EvidenceEmbedding {
  id          String   @id @default(cuid())
  evidenceId  String   @unique
  tenantId    String
  embedding   Unsupported("vector(384)")?
  model       String
  createdAt   DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("evidence_embeddings")
}

// ============================================================
// STRATEGY CONTRACTS (00-05)
// ============================================================

model Strategy {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String?
  // Status: draft | submitted | approved | archived
  status      String   @default("draft")
  // G01 (migration 0017): groups alternatives from the same composer run.
  // Nullable: existing G00 strategies have no batch. RLS-enforced (same policy as the rest of the table).
  compositionBatchId String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions StrategyVersion[]

  @@index([tenantId, status])
  @@index([tenantId, compositionBatchId])
  @@map("strategies")
}

model StrategyVersion {
  id             String    @id @default(cuid())
  strategyId     String
  tenantId       String
  versionNumber  Int
  content        String
  // Status: draft | approved | superseded
  status         String    @default("draft")
  approvedBy     String?
  approvedAt     DateTime?
  approvalNotes  String?
  // G01 (migration 0017): provenance metadata.
  // Stores { simulated, provider, composedAt, compositionBatchId, modelVersion }.
  // Immutable post-approval (the extended enforce_approved_version_immutability() trigger
  // blocks UPDATE on this column for approved versions — see migration 0017).
  metadata       Json      @default("{}")
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  strategy  Strategy   @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decisions Decision[]
  // G01 (migration 0017): State Builder child entities
  programs      Program[]
  riskRegisters RiskRegister[]
  assumptions   Assumption[]

  @@unique([strategyId, versionNumber])
  @@index([tenantId, status])
  @@map("strategy_versions")
}

model Decision {
  id                String   @id @default(cuid())
  tenantId          String
  strategyVersionId String?
  title             String
  rationale         String
  decidedBy         String
  decidedAt         DateTime @default(now())
  // Status: proposed | reviewed | approved | implemented | reversed
  status            String   @default("proposed")
  // Evidence snapshot at decision time (JSONB arrays)
  supportingEvidence Json    @default("[]")
  counterEvidence    Json    @default("[]")
  metadata           Json    @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  strategyVersion StrategyVersion? @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  events          DecisionEvent[]

  @@index([tenantId, status])
  @@index([strategyVersionId])
  @@map("decisions")
}

model DecisionEvent {
  id         String   @id @default(cuid())
  decisionId String
  tenantId   String
  // EventType: proposed | reviewed | approved | implemented | reversed | notes_added
  eventType  String
  actor      String
  at         DateTime @default(now())
  notes      String?
  metadata   Json     @default("{}")

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([decisionId, at])
  @@index([tenantId, at])
  @@map("decision_events")
}

model Event {
  id         String   @id @default(cuid())
  tenantId   String
  eventType  String
  actor      String
  entityType String?
  entityId   String?
  at         DateTime @default(now())
  metadata   Json     @default("{}")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, at])
  @@index([entityType, entityId])
  @@map("events")
}

// NOTE: pgvector extension is enabled via the first SQL migration.
// Vector columns will be added in mission 00-04 (Evidence) on the
// `evidence_embeddings` table, not on a Prisma model directly.

// ============================================================
// DURABLE TASK RUNTIME (00-06)
// ============================================================

model Task {
  id              String    @id @default(cuid())
  tenantId        String
  type            String
  goal            String
  // Status: pending → claimed → running → completed | failed | abandoned
  status          String    @default("pending")
  idempotencyKey  String?
  input           Json      @default("{}")
  output          Json?
  error           String?
  progress        Int       @default(0)
  claimedBy       String?
  claimGeneration Int       @default(0)
  leaseExpiresAt  DateTime?
  priority        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events  TaskEvent[]
  capabilityInvocations CapabilityInvocation[]

  @@index([tenantId, status])
  @@index([status, priority, createdAt])
  @@unique([tenantId, idempotencyKey])
  @@index([leaseExpiresAt])
  @@map("tasks")
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  tenantId  String
  eventType String
  actor     String   @default("system")
  at        DateTime @default(now())
  details   Json     @default("{}")

  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([taskId, at])
  @@index([tenantId, at])
  @@map("task_events")
}

// ============================================================
// CAPABILITY REGISTRY (00-07)
// ============================================================

model Capability {
  id                String   @id @default(cuid())
  code              String   @unique
  displayName       String
  description       String
  // Type: "tool" | "expert" | "source" | "adapter"
  type              String
  // Readiness: "stub" | "mock" | "live" | "untested"
  readiness         String   @default("stub")
  inputSchema       Json     @default("{}")
  outputSchema      Json     @default("{}")
  requiredPermission String
  domains           Json     @default("[]")
  adapterEndpoint   String?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  invocations CapabilityInvocation[]

  @@index([type])
  @@index([readiness])
  @@map("capabilities")
}

model CapabilityInvocation {
  id            String    @id @default(cuid())
  tenantId      String
  capabilityId  String
  taskId        String?
  invokedBy     String
  input         Json      @default("{}")
  output        Json?
  status        String    @default("pending")
  error         String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capability Capability @relation(fields: [capabilityId], references: [id])
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([capabilityId])
  @@index([taskId])
  @@map("capability_invocations")
}

// ============================================================
// G01 STATE BUILDER (01-00) — 8 new PRIVATE tables
// ------------------------------------------------------------
// All tenant-scoped, RLS ENABLE + FORCE (see migration 0017).
// Per ADR-0013 + G01 Mission Pack §13 (Corrections 1, 2, 3, A).
//
// PUBLIC reference data (countries, institutions, state_hierarchy, role_references,
// source_registry, public_knowledge) stays in G00 tables — G01 reads them, never
// duplicates them. A tenant's planning data (objectives, country_pack_configs,
// programs, etc.) is PRIVATE and never visible to other tenants.
// ============================================================

model Objective {
  id           String   @id @default(cuid())
  tenantId     String
  countryId    String
  title        String
  description  String?
  // Target metric (e.g., "unemployment_rate")
  targetMetric String
  // Target value (e.g., "10" for 10%) — TEXT to support different units
  targetValue  String
  // Horizon in years (e.g., 5 for a 5-year goal)
  horizon      Int
  // Status: draft | active | achieved | abandoned
  status       String   @default("draft")
  createdBy    String
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  country Country  @relation(fields: [countryId], references: [id])

  @@index([tenantId, countryId])
  @@index([tenantId, status])
  @@map("objectives")
}

model CountryPackConfig {
  id                  String   @id @default(cuid())
  tenantId            String
  countryId           String
  // Sectors this tenant tracks (e.g., ["agriculture","finance","health"])
  sectors             Json     @default("[]")
  // Observability mode per sector: { "agriculture": "FULL", "health": "PARTIAL", ... }
  observability       Json     @default("{}")
  // Tenant-specific planning assumptions
  planningAssumptions Json     @default("{}")
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id])

  @@unique([tenantId, countryId])
  @@map("country_pack_configs")
}

model Program {
  id                   String   @id @default(cuid())
  tenantId             String
  strategyVersionId    String
  title                String
  sector               String
  // Owning institution (references PUBLIC institutions table; no FK because cross-country
  // validation is enforced at the service layer in mission 01-04)
  owningInstitutionId  String?
  legalMandateRef      String?
  rationale            String?
  // Status: draft | proposed | active | completed | retired
  status               String   @default("draft")
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  projects        Project[]
  budgetLines     BudgetLine[]
  dependenciesFrom Dependency[] @relation("DependencyFrom")
  dependenciesTo   Dependency[] @relation("DependencyTo")

  @@index([tenantId, strategyVersionId])
  @@index([tenantId, sector])
  @@map("programs")
}

model Project {
  id          String   @id @default(cuid())
  tenantId    String
  programId   String
  title       String
  description String?
  // Status: draft | planned | active | completed | suspended | cancelled
  status      String   @default("draft")
  startYear   Int?
  endYear     Int?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([tenantId, programId])
  @@map("projects")
}

model BudgetLine {
  id              String   @id @default(cuid())
  tenantId        String
  programId       String
  currency        String
  // Conditional RANGES (min/max), never point estimates (no fake precision)
  minAmount       Decimal  @db.Decimal(20, 2)
  maxAmount       Decimal  @db.Decimal(20, 2)
  horizonYears    Int
  assumptions     Json     @default("[]")
  financingSources Json    @default("[]")
  modelVersion    String   @default("v1-deterministic")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([tenantId, programId, modelVersion])
  @@index([tenantId, programId])
  @@map("budget_lines")
}

model Dependency {
  id            String   @id @default(cuid())
  tenantId      String
  fromProgramId String
  toProgramId   String
  // type: requires | enables | conflicts
  type          String
  rationale     String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromProgram Program @relation("DependencyFrom", fields: [fromProgramId], references: [id], onDelete: Cascade)
  toProgram   Program @relation("DependencyTo", fields: [toProgramId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromProgramId, toProgramId, type])
  @@index([tenantId, fromProgramId])
  @@index([tenantId, toProgramId])
  @@map("dependencies")
}

model RiskRegister {
  id                String   @id @default(cuid())
  tenantId          String
  strategyVersionId String
  title             String
  description       String?
  // severity: low | medium | high | critical
  severity          String   @default("medium")
  // likelihood: low | medium | high
  likelihood        String   @default("medium")
  mitigation        String?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, strategyVersionId])
  @@map("risk_registers")
}

model Assumption {
  id                String   @id @default(cuid())
  tenantId          String
  strategyVersionId String
  title             String
  description       String?
  // How this assumption can be validated (e.g., "monitor quarterly")
  validationMethod  String?
  // status: unverified | validated | invalidated
  status            String   @default("unverified")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, strategyVersionId])
  @@map("assumptions")
}
