// The Balance — Prisma Schema
// GROUP 00 Foundation
// 00-01: Tenant + AuditLog (initial)
// 00-02: Country + StateHierarchy + Institution + RoleReference + SourceRegistry + PublicKnowledge
// Future: User (00-03), Evidence+Source (00-04), Strategy+Event (00-05), Task (00-06), Capability (00-07).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // pgvector extension + RLS policies + roles are managed via raw SQL
  // migrations (see prisma/migrations/).
}

// ============================================================
// PUBLIC SCOPE — Global reference data, no tenant_id
// ============================================================

model Country {
  id          String   @id @default(cuid())
  iso3        String   @unique // "SYR", "JOR" — ISO 3166-1 alpha-3
  iso2        String?  @unique // "SY", "JO" — ISO 3166-1 alpha-2
  displayName String
  status      String   @default("active") // active | suspended | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants        Tenant[]
  stateHierarchy StateHierarchy[]
  institutions   Institution[]

  @@map("countries")
  @@index([status])
}

model StateHierarchy {
  id          String   @id @default(cuid())
  countryId   String
  parentId    String? // self-reference for nesting
  code        String // "SY-DAM" for Damascus province
  displayName String
  // Level: "nation" | "province" | "district" | "municipality" | "neighborhood"
  level       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country  Country          @relation(fields: [countryId], references: [id])
  parent   StateHierarchy?  @relation("StateHierarchyTree", fields: [parentId], references: [id])
  children StateHierarchy[] @relation("StateHierarchyTree")

  @@unique([countryId, code])
  @@index([countryId, level])
  @@map("state_hierarchy")
}

model Institution {
  id          String   @id @default(cuid())
  countryId   String
  parentId    String? // self-reference for nesting
  code        String
  displayName String
  // Type: "ministry" | "agency" | "authority" | "directorate" | "council"
  type        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country  Country      @relation(fields: [countryId], references: [id])
  parent   Institution? @relation("InstitutionTree", fields: [parentId], references: [id])
  children Institution[] @relation("InstitutionTree")

  @@unique([countryId, code])
  @@map("institutions")
}

model RoleReference {
  id          String   @id @default(cuid())
  code        String   @unique // "admin", "analyst", "reviewer", "observer"
  displayName String
  description String
  // Catalog of permissions for this role (JSON Schema-like).
  permissions Json  @default("{}")
  createdAt   DateTime @default(now())

  memberships Membership[]

  @@map("role_references")
}

model SourceRegistry {
  id          String   @id @default(cuid())
  code        String   @unique // "WORLD_BANK", "IMF", "UN_STATS"
  displayName String
  // Type: "international_org" | "academic" | "government" | "media" | "ngo"
  type        String
  license     String?
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publicKnowledge PublicKnowledge[]

  @@map("source_registry")
  @@index([type])
}

model PublicKnowledge {
  id          String   @id @default(cuid())
  sourceId    String? // optional FK to SourceRegistry
  title       String
  content     String
  metadata    Json  @default("{}")
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  source SourceRegistry? @relation(fields: [sourceId], references: [id])

  @@index([title])
  @@index([publishedAt])
  @@map("public_knowledge")
}

// ============================================================
// PRIVATE SCOPE — Tenant-specific data (RLS-enforced)
// ============================================================

model Tenant {
  id          String   @id @default(cuid())
  code        String   @unique // "SY-MIN-PLAN", "SY-CB" — independent of Country.iso3
  displayName String
  countryId   String
  status      String   @default("active") // active | suspended | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country    Country       @relation(fields: [countryId], references: [id])
  auditLogs  AuditLog[]
  memberships Membership[]
  evidence    Evidence[]
  evidenceEmbeddings EvidenceEmbedding[]

  @@map("tenants")
  @@index([status])
  @@index([countryId])
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now())
  // Who: tenant + actor (user id or "system")
  tenantId    String?
  actor       String   @default("system")
  // What: action verb (e.g., "tenant.create", "auth.login", "evidence.read")
  action      String
  // Where: request context
  route       String?
  method      String?
  ipHash      String? // hashed, never raw
  // Payload: structured details (JSONB). Secrets are stripped before insert.
  details     Json     @default("{}")
  // Outcome
  status      String   @default("ok") // ok | error | denied
  errorCode   String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@map("audit_log")
  @@index([tenantId, at])
  @@index([action, at])
}

// ============================================================
// IDENTITY (00-03) — User + Membership
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // Status lifecycle: active | suspended | disabled
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@map("users")
  @@index([status])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  roleCode  String
  // Status lifecycle: active | revoked
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   RoleReference @relation(fields: [roleCode], references: [code])

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
  @@map("memberships")
}

// ============================================================
// EVIDENCE FABRIC (00-04)
// ============================================================

model Source {
  id               String   @id @default(cuid())
  code             String   @unique
  displayName      String
  // Type: "international_org" | "academic" | "government" | "media" | "ngo"
  type             String
  license          String?
  url              String?
  urlHash          String?  @unique
  // Independence group: sources in the same group are NOT independent
  // (e.g., syndicated news feeds). Used for dedup + independence counting.
  independenceGroup String?
  // Review status: "candidate" (tenant-submitted, not reviewed) | "approved" (global)
  reviewStatus     String   @default("approved")
  // Which tenant submitted this candidate (null for admin-curated)
  submittedByTenantId String?
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  evidence Evidence[]

  @@index([type])
  @@index([independenceGroup])
  @@index([reviewStatus])
  @@map("sources")
}

model Evidence {
  id                String   @id @default(cuid())
  tenantId          String
  sourceId          String?
  claim             String
  summary           String?
  // Type: "supporting" | "counter" | "neutral"
  type              String   @default("neutral")
  // Links to another evidence this supports/contradicts
  relatedEvidenceId String?
  // Verification: "unverified" | "verified" | "disputed" | "refuted"
  verificationStatus String  @default("unverified")
  // Provenance: when observed vs when recorded
  observedAt        DateTime?
  retrievedAt       DateTime @default(now())
  extractionMethod  String?
  // Classification: "public" | "classified" | "restricted"
  classification    String   @default("public")
  confidenceNotes   String?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant     Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source     Source?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  relatedTo  Evidence?        @relation("EvidenceRelations", fields: [relatedEvidenceId], references: [id], onDelete: SetNull)
  relatedBy  Evidence[]       @relation("EvidenceRelations")
  embedding  EvidenceEmbedding?

  @@index([tenantId, type])
  @@index([tenantId, verificationStatus])
  @@index([tenantId, classification])
  @@index([relatedEvidenceId])
  @@map("evidence")
}

model EvidenceEmbedding {
  id          String   @id @default(cuid())
  evidenceId  String   @unique
  tenantId    String
  // pgvector — stored as Unsupported("vector(384)") because Prisma
  // doesn't natively support pgvector. Read/write via raw SQL.
  embedding   Unsupported("vector(384)")?
  model       String
  createdAt   DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("evidence_embeddings")
}

// NOTE: pgvector extension is enabled via the first SQL migration.
// Vector columns will be added in mission 00-04 (Evidence) on the
// `evidence_embeddings` table, not on a Prisma model directly.
