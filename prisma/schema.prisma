// The Balance — Prisma Schema
// GROUP 00 Foundation
// 00-01: Tenant + AuditLog (initial)
// 00-02: Country + StateHierarchy + Institution + RoleReference + SourceRegistry + PublicKnowledge
// Future: User (00-03), Evidence+Source (00-04), Strategy+Event (00-05), Task (00-06), Capability (00-07).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // pgvector extension + RLS policies + roles are managed via raw SQL
  // migrations (see prisma/migrations/).
}

// ============================================================
// PUBLIC SCOPE — Global reference data, no tenant_id
// ============================================================

model Country {
  id          String   @id @default(cuid())
  iso3        String   @unique // "SYR", "JOR" — ISO 3166-1 alpha-3
  iso2        String?  @unique // "SY", "JO" — ISO 3166-1 alpha-2
  displayName String
  status      String   @default("active") // active | suspended | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants        Tenant[]
  stateHierarchy StateHierarchy[]
  institutions   Institution[]
  // G01 (migration 0017): tenant-scoped planning data referencing this country
  objectives         Objective[]
  countryPackConfigs CountryPackConfig[]
  // G03: reform coordinations reference country
  reformCoordinationsCountry  ReformCoordination[] @relation("ReformCoordinationCountry")

  @@map("countries")
  @@index([status])
}

model StateHierarchy {
  id          String   @id @default(cuid())
  countryId   String
  parentId    String? // self-reference for nesting
  code        String // "SY-DAM" for Damascus province
  displayName String
  // Level: "nation" | "province" | "district" | "municipality" | "neighborhood"
  level       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country  Country          @relation(fields: [countryId], references: [id])
  parent   StateHierarchy?  @relation("StateHierarchyTree", fields: [parentId], references: [id])
  children StateHierarchy[] @relation("StateHierarchyTree")

  @@unique([countryId, code])
  @@index([countryId, level])
  @@map("state_hierarchy")
}

model Institution {
  id          String   @id @default(cuid())
  countryId   String
  parentId    String? // self-reference for nesting
  code        String
  displayName String
  // Type: "ministry" | "agency" | "authority" | "directorate" | "council"
  type        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country  Country      @relation(fields: [countryId], references: [id])
  parent   Institution? @relation("InstitutionTree", fields: [parentId], references: [id])
  children Institution[] @relation("InstitutionTree")

  @@unique([countryId, code])
  @@map("institutions")
}

model RoleReference {
  id          String   @id @default(cuid())
  code        String   @unique // "admin", "analyst", "reviewer", "observer"
  displayName String
  description String
  // Catalog of permissions for this role (JSON Schema-like).
  permissions Json  @default("{}")
  createdAt   DateTime @default(now())

  memberships Membership[]

  @@map("role_references")
}

model SourceRegistry {
  id          String   @id @default(cuid())
  code        String   @unique // "WORLD_BANK", "IMF", "UN_STATS"
  displayName String
  // Type: "international_org" | "academic" | "government" | "media" | "ngo"
  type        String
  license     String?
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publicKnowledge PublicKnowledge[]

  @@map("source_registry")
  @@index([type])
}

model PublicKnowledge {
  id          String   @id @default(cuid())
  sourceId    String? // optional FK to SourceRegistry
  title       String
  content     String
  metadata    Json  @default("{}")
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  source SourceRegistry? @relation(fields: [sourceId], references: [id])

  @@index([title])
  @@index([publishedAt])
  @@map("public_knowledge")
}

// ============================================================
// PRIVATE SCOPE — Tenant-specific data (RLS-enforced)
// ============================================================

model Tenant {
  id          String   @id @default(cuid())
  code        String   @unique // "SY-MIN-PLAN", "SY-CB" — independent of Country.iso3
  displayName String
  countryId   String
  status      String   @default("active") // active | suspended | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country    Country       @relation(fields: [countryId], references: [id])
  auditLogs  AuditLog[]
  memberships Membership[]
  evidence    Evidence[]
  evidenceEmbeddings EvidenceEmbedding[]
  strategies  Strategy[]
  strategyVersions StrategyVersion[]
  decisions   Decision[]
  decisionEvents DecisionEvent[]
  events      Event[]
  tasks       Task[]
  taskEvents  TaskEvent[]
  capabilityInvocations CapabilityInvocation[]
  // G01 (migration 0017): tenant-scoped State Builder planning data
  objectives         Objective[]
  countryPackConfigs CountryPackConfig[]
  programs           Program[]
  projects           Project[]
  budgetLines        BudgetLine[]
  dependencies       Dependency[]
  riskRegisters      RiskRegister[]
  assumptions        Assumption[]
  // G02 (migration 0021): tenant-scoped State Observatory data
  indicatorDefinitions IndicatorDefinition[]
  observationPeriods   ObservationPeriod[]
  observations         Observation[]
  varianceRecords      VarianceRecord[]
  alerts               Alert[]
  // G03 (migration 0022): tenant-scoped State Reform data
  reformProposals        ReformProposal[]
  reformAlternatives     ReformAlternative[]
  reformApprovals        ReformApproval[]
  reformActions          ReformAction[]
  reformActionUpdates    ReformActionUpdate[]
  reformVerifications    ReformVerification[]
  reformFeedbackLoops    ReformFeedbackLoop[]
  reformCoordinationParticipants ReformCoordinationParticipant[]
  reformCoordinationSharedSnapshots ReformCoordinationSharedSnapshot[]
  reformCoordinationsLead  ReformCoordination[]
  // G04 (migration 0033): tenant-scoped Strategic Continuity data
  handoverDossiers   HandoverDossier[]

  @@map("tenants")
  @@index([status])
  @@index([countryId])
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now())
  // Who: tenant + actor (user id or "system")
  tenantId    String?
  actor       String   @default("system")
  // What: action verb (e.g., "tenant.create", "auth.login", "evidence.read")
  action      String
  // Where: request context
  route       String?
  method      String?
  ipHash      String? // hashed, never raw
  // Payload: structured details (JSONB). Secrets are stripped before insert.
  details     Json     @default("{}")
  // Outcome
  status      String   @default("ok") // ok | error | denied
  errorCode   String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@map("audit_log")
  @@index([tenantId, at])
  @@index([action, at])
}

// ============================================================
// IDENTITY (00-03) — User + Membership
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // Status lifecycle: active | suspended | disabled
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@map("users")
  @@index([status])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  roleCode  String
  // Status lifecycle: active | revoked
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   RoleReference @relation(fields: [roleCode], references: [code])

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
  @@map("memberships")
}

// ============================================================
// EVIDENCE FABRIC (00-04)
// ============================================================

model Source {
  id               String   @id @default(cuid())
  code             String   @unique
  displayName      String
  // Type: "international_org" | "academic" | "government" | "media" | "ngo"
  type             String
  license          String?
  url              String?
  urlHash          String?  @unique
  // Independence group: sources in the same group are NOT independent
  // (e.g., syndicated news feeds). Used for dedup + independence counting.
  independenceGroup String?
  // Review status: "candidate" (tenant-submitted, not reviewed) | "approved" (global)
  reviewStatus     String   @default("approved")
  // Which tenant submitted this candidate (null for admin-curated)
  submittedByTenantId String?
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  evidence Evidence[]
  // G02 (migration 0021): observations referencing this source
  observations Observation[]

  @@index([type])
  @@index([independenceGroup])
  @@index([reviewStatus])
  @@map("sources")
}

model Evidence {
  id                String   @id @default(cuid())
  tenantId          String
  sourceId          String?
  claim             String
  summary           String?
  // Type: "supporting" | "counter" | "neutral"
  type              String   @default("neutral")
  // Links to another evidence this supports/contradicts
  relatedEvidenceId String?
  // Verification: "unverified" | "verified" | "disputed" | "refuted"
  verificationStatus String  @default("unverified")
  // Provenance: when observed vs when recorded
  observedAt        DateTime?
  retrievedAt       DateTime @default(now())
  extractionMethod  String?
  // Classification: "public" | "classified" | "restricted"
  classification    String   @default("public")
  confidenceNotes   String?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant     Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source     Source?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  relatedTo  Evidence?        @relation("EvidenceRelations", fields: [relatedEvidenceId], references: [id], onDelete: SetNull)
  relatedBy  Evidence[]       @relation("EvidenceRelations")
  embedding  EvidenceEmbedding?
  // G02 (migration 0021): observations referencing this evidence
  observations Observation[]

  @@index([tenantId, type])
  @@index([tenantId, verificationStatus])
  @@index([tenantId, classification])
  @@index([relatedEvidenceId])
  @@map("evidence")
}

model EvidenceEmbedding {
  id          String   @id @default(cuid())
  evidenceId  String   @unique
  tenantId    String
  embedding   Unsupported("vector(384)")?
  model       String
  createdAt   DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("evidence_embeddings")
}

// ============================================================
// STRATEGY CONTRACTS (00-05)
// ============================================================

model Strategy {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String?
  // Status: draft | submitted | approved | archived
  status      String   @default("draft")
  // G01 (migration 0017): groups alternatives from the same composer run.
  // Nullable: existing G00 strategies have no batch. RLS-enforced (same policy as the rest of the table).
  compositionBatchId String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions StrategyVersion[]

  @@index([tenantId, status])
  @@index([tenantId, compositionBatchId])
  @@map("strategies")
}

model StrategyVersion {
  id             String    @id @default(cuid())
  strategyId     String
  tenantId       String
  versionNumber  Int
  content        String
  // Status: draft | approved | superseded
  status         String    @default("draft")
  approvedBy     String?
  approvedAt     DateTime?
  approvalNotes  String?
  // G01 (migration 0017): provenance metadata.
  // Stores { simulated, provider, composedAt, compositionBatchId, modelVersion }.
  // Immutable post-approval (the extended enforce_approved_version_immutability() trigger
  // blocks UPDATE on this column for approved versions — see migration 0017).
  metadata       Json      @default("{}")
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  strategy  Strategy   @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decisions Decision[]
  // G01 (migration 0017): State Builder child entities
  programs      Program[]
  riskRegisters RiskRegister[]
  assumptions   Assumption[]
  // G02 (migration 0021): State Observatory entities referencing this version (read-only FK)
  indicatorDefinitions IndicatorDefinition[]
  observations         Observation[]
  varianceRecords      VarianceRecord[]
  alerts               Alert[]
  // G03: reform proposals + coordinations can reference this alert
  reformProposals      ReformProposal[]
  @@index([tenantId, status])
  @@map("strategy_versions")
}

model Decision {
  id                String   @id @default(cuid())
  tenantId          String
  strategyVersionId String?
  title             String
  rationale         String
  decidedBy         String
  decidedAt         DateTime @default(now())
  // Status: proposed | reviewed | approved | implemented | reversed
  status            String   @default("proposed")
  // Evidence snapshot at decision time (JSONB arrays)
  supportingEvidence Json    @default("[]")
  counterEvidence    Json    @default("[]")
  metadata           Json    @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  strategyVersion StrategyVersion? @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  events          DecisionEvent[]

  @@index([tenantId, status])
  @@index([strategyVersionId])
  @@map("decisions")
}

model DecisionEvent {
  id         String   @id @default(cuid())
  decisionId String
  tenantId   String
  // EventType: proposed | reviewed | approved | implemented | reversed | notes_added
  eventType  String
  actor      String
  at         DateTime @default(now())
  notes      String?
  metadata   Json     @default("{}")

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([decisionId, at])
  @@index([tenantId, at])
  @@map("decision_events")
}

// ============================================================
// G04 Delivery 03 — Strategic Continuity
// ------------------------------------------------------------
// HandoverDossier: persisted snapshot of a government handover dossier.
// Generated by an authorized user (reviewer/admin) for retrieval by an
// incoming administration. Content is IMMUTABLE post-publication (enforced
// at the DB level by enforce_handover_dossier_immutability() trigger in
// migration 0033) — only retrieval-tracking columns may be updated.
// ============================================================
model HandoverDossier {
  id              String   @id @default(cuid())
  tenantId        String
  title           String
  // Scope JSONB: what the dossier covers (strategyVersionIds, decisionIds, etc.)
  scope           Json     @default("{}")
  // Content JSONB: the structured dossier payload (strategies, decisions,
  // actions, obligations, evidence, risks, uncertainties, auditHighlights)
  content         Json     @default("{}")
  generatedBy     String
  generatedAt     DateTime @default(now())
  retrievedBy     String?
  retrievedAt     DateTime?
  retrievalCount  Int      @default(0)
  // Status: draft | published | archived | superseded
  status          String   @default("published")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, generatedAt])
  @@index([tenantId, createdAt])
  @@map("handover_dossiers")
}

model Event {
  id         String   @id @default(cuid())
  tenantId   String
  eventType  String
  actor      String
  entityType String?
  entityId   String?
  at         DateTime @default(now())
  metadata   Json     @default("{}")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, at])
  @@index([entityType, entityId])
  @@map("events")
}

// NOTE: pgvector extension is enabled via the first SQL migration.
// Vector columns will be added in mission 00-04 (Evidence) on the
// `evidence_embeddings` table, not on a Prisma model directly.

// ============================================================
// DURABLE TASK RUNTIME (00-06)
// ============================================================

model Task {
  id              String    @id @default(cuid())
  tenantId        String
  type            String
  goal            String
  // Status: pending → claimed → running → completed | failed | abandoned
  status          String    @default("pending")
  idempotencyKey  String?
  input           Json      @default("{}")
  output          Json?
  error           String?
  progress        Int       @default(0)
  claimedBy       String?
  claimGeneration Int       @default(0)
  leaseExpiresAt  DateTime?
  priority        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events  TaskEvent[]
  capabilityInvocations CapabilityInvocation[]

  @@index([tenantId, status])
  @@index([status, priority, createdAt])
  @@unique([tenantId, idempotencyKey])
  @@index([leaseExpiresAt])
  @@map("tasks")
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  tenantId  String
  eventType String
  actor     String   @default("system")
  at        DateTime @default(now())
  details   Json     @default("{}")

  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([taskId, at])
  @@index([tenantId, at])
  @@map("task_events")
}

// ============================================================
// CAPABILITY REGISTRY (00-07)
// ============================================================

model Capability {
  id                String   @id @default(cuid())
  code              String   @unique
  displayName       String
  description       String
  // Type: "tool" | "expert" | "source" | "adapter"
  type              String
  // Readiness: "stub" | "mock" | "live" | "untested"
  readiness         String   @default("stub")
  inputSchema       Json     @default("{}")
  outputSchema      Json     @default("{}")
  requiredPermission String
  domains           Json     @default("[]")
  adapterEndpoint   String?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  invocations CapabilityInvocation[]

  @@index([type])
  @@index([readiness])
  @@map("capabilities")
}

model CapabilityInvocation {
  id            String    @id @default(cuid())
  tenantId      String
  capabilityId  String
  taskId        String?
  invokedBy     String
  input         Json      @default("{}")
  output        Json?
  status        String    @default("pending")
  error         String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capability Capability @relation(fields: [capabilityId], references: [id])
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([capabilityId])
  @@index([taskId])
  @@map("capability_invocations")
}

// ============================================================
// G01 STATE BUILDER (01-00) — 8 new PRIVATE tables
// ------------------------------------------------------------
// All tenant-scoped, RLS ENABLE + FORCE (see migration 0017).
// Per ADR-0013 + G01 Mission Pack §13 (Corrections 1, 2, 3, A).
//
// PUBLIC reference data (countries, institutions, state_hierarchy, role_references,
// source_registry, public_knowledge) stays in G00 tables — G01 reads them, never
// duplicates them. A tenant's planning data (objectives, country_pack_configs,
// programs, etc.) is PRIVATE and never visible to other tenants.
// ============================================================

model Objective {
  id           String   @id @default(cuid())
  tenantId     String
  countryId    String
  title        String
  description  String?
  // Target metric (e.g., "unemployment_rate")
  targetMetric String
  // Target value (e.g., "10" for 10%) — TEXT to support different units
  targetValue  String
  // Horizon in years (e.g., 5 for a 5-year goal)
  horizon      Int
  // Status: draft | active | achieved | abandoned
  status       String   @default("draft")
  createdBy    String
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  country Country  @relation(fields: [countryId], references: [id])
  // G02 (migration 0021): indicators referencing this objective
  indicatorDefinitions IndicatorDefinition[]
  // G03: reform proposals can reference this objective
  reformProposals      ReformProposal[]

  @@index([tenantId, countryId])
  @@index([tenantId, status])
  @@map("objectives")
}

model CountryPackConfig {
  id                  String   @id @default(cuid())
  tenantId            String
  countryId           String
  // Sectors this tenant tracks (e.g., ["agriculture","finance","health"])
  sectors             Json     @default("[]")
  // Observability mode per sector: { "agriculture": "FULL", "health": "PARTIAL", ... }
  observability       Json     @default("{}")
  // Tenant-specific planning assumptions
  planningAssumptions Json     @default("{}")
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id])

  @@unique([tenantId, countryId])
  @@map("country_pack_configs")
}

model Program {
  id                   String   @id @default(cuid())
  tenantId             String
  strategyVersionId    String
  title                String
  sector               String
  // Owning institution (references PUBLIC institutions table; no FK because cross-country
  // validation is enforced at the service layer in mission 01-04)
  owningInstitutionId  String?
  legalMandateRef      String?
  rationale            String?
  // Status: draft | proposed | active | completed | retired
  status               String   @default("draft")
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  projects        Project[]
  budgetLines     BudgetLine[]
  dependenciesFrom Dependency[] @relation("DependencyFrom")
  dependenciesTo   Dependency[] @relation("DependencyTo")
  // G02 (migration 0021): indicators referencing this program
  indicatorDefinitions IndicatorDefinition[]
  // G03: reform actions can link to programs
  reformActions        ReformAction[]

  @@index([tenantId, strategyVersionId])
  @@index([tenantId, sector])
  @@map("programs")
}

model Project {
  id          String   @id @default(cuid())
  tenantId    String
  programId   String
  title       String
  description String?
  // Status: draft | planned | active | completed | suspended | cancelled
  status      String   @default("draft")
  startYear   Int?
  endYear     Int?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  // G03: reform actions can link to projects
  reformActions ReformAction[]

  @@index([tenantId, programId])
  @@map("projects")
}

model BudgetLine {
  id              String   @id @default(cuid())
  tenantId        String
  programId       String
  currency        String
  // Conditional RANGES (min/max), never point estimates (no fake precision)
  minAmount       Decimal  @db.Decimal(20, 2)
  maxAmount       Decimal  @db.Decimal(20, 2)
  horizonYears    Int
  assumptions     Json     @default("[]")
  financingSources Json    @default("[]")
  modelVersion    String   @default("v1-deterministic")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([tenantId, programId, modelVersion])
  @@index([tenantId, programId])
  @@map("budget_lines")
}

model Dependency {
  id            String   @id @default(cuid())
  tenantId      String
  fromProgramId String
  toProgramId   String
  // type: requires | enables | conflicts
  type          String
  rationale     String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromProgram Program @relation("DependencyFrom", fields: [fromProgramId], references: [id], onDelete: Cascade)
  toProgram   Program @relation("DependencyTo", fields: [toProgramId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromProgramId, toProgramId, type])
  @@index([tenantId, fromProgramId])
  @@index([tenantId, toProgramId])
  @@map("dependencies")
}

model RiskRegister {
  id                String   @id @default(cuid())
  tenantId          String
  strategyVersionId String
  title             String
  description       String?
  // severity: low | medium | high | critical
  severity          String   @default("medium")
  // likelihood: low | medium | high
  likelihood        String   @default("medium")
  mitigation        String?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, strategyVersionId])
  @@map("risk_registers")
}

model Assumption {
  id                String   @id @default(cuid())
  tenantId          String
  strategyVersionId String
  title             String
  description       String?
  // How this assumption can be validated (e.g., "monitor quarterly")
  validationMethod  String?
  // status: unverified | validated | invalidated
  status            String   @default("unverified")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, strategyVersionId])
  @@map("assumptions")
}

// ============================================================
// G02 STATE OBSERVATORY (02-00) — 5 new PRIVATE tables
// ------------------------------------------------------------
// All tenant-scoped, RLS ENABLE + FORCE (see migration 0021).
// Per REV-5 FINAL CORRECTED MISSION spec:
//   - Q1-Q15 (architecture) + R1-R5 (refinements) + E1-E8 (execution)
//     + F1-F6 (final fixes) — all frozen.
//
// Key invariants:
//   - StrategyVersion referenced as READ-ONLY FK (never modified).
//   - Observations are append-only with correction chains (R4).
//   - isCurrent uniqueness enforced via partial unique index with
//     COALESCE(geo_ref_id, '') for NULL safety (F1).
//   - Chain integrity (no branching, no cycles, no self-reference,
//     same indicator+period+geo) enforced via DB trigger (F3).
//   - VarianceRecord.observationId is NULLABLE (null when unknown) (F4).
//   - plannedValueSourceKind/SourceId are NULLABLE (null when
//     plannedValueType="none") (F4).
//   - Alert separates lifecycle from executionStatus; verifyExecution
//     requires verifiedAction + evidenceSource (F6).
//   - attributionLevel = "descriptive" always (no causal claims).
// ============================================================

model IndicatorDefinition {
  id                          String   @id @default(cuid())
  tenantId                    String
  code                        String
  displayName                 String
  description                 String?
  // Blueprint §5.2 — full indicator definition
  unit                        String
  formula                     String?
  preferredDirection          String // "increase" | "decrease" | "stable"
  preferredDirectionRationale String?
  geographicLevels            Json     @default("[]")
  coverage                    String?
  frequency                   String? // "yearly" | "quarterly" | "monthly"
  methodologyDate             DateTime?
  measurementConstraints      Json     @default("{}")
  uncertaintyMethod           String?
  usedBy                      Json     @default("[]")
  // Read-only FK to G01 approved entities
  objectiveId                 String?
  programId                   String?
  strategyVersionId           String?
  // R2 — temporal targets
  defaultTargetValue          Decimal? @db.Decimal(20, 4)
  targetTimeHorizon           String   @default("annual") // "period" | "annual" | "multi_year"
  periodMilestones            Json     @default("[]")
  // R3 + E5 — structured alert thresholds (max 2 rules; [] = no auto-alert)
  alertThresholds             Json     @default("[]")
  status                      String   @default("draft") // "draft" | "active" | "retired"
  createdBy                   String
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  tenant           Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objective        Objective?       @relation(fields: [objectiveId], references: [id])
  program          Program?         @relation(fields: [programId], references: [id])
  strategyVersion  StrategyVersion? @relation(fields: [strategyVersionId], references: [id])
  observations     Observation[]
  varianceRecords  VarianceRecord[]
  alerts           Alert[]
  // G03: reform proposals can reference this indicator's alert

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, strategyVersionId])
  @@index([tenantId, objectiveId])
  @@map("indicator_definitions")
}

model ObservationPeriod {
  id          String   @id @default(cuid())
  tenantId    String
  periodType  String // "yearly" | "quarterly" | "monthly"
  periodValue String // "2026" | "2026-Q1" | "2026-03"
  startAt     DateTime
  endAt       DateTime
  status      String   @default("open") // "open" | "closed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  observations Observation[]
  varianceRecords VarianceRecord[]

  @@unique([tenantId, periodType, periodValue])
  @@index([tenantId, status])
  @@map("observation_periods")
}

model Observation {
  id                      String   @id @default(cuid())
  tenantId                String
  indicatorDefinitionId   String
  strategyVersionId       String? // read-only FK
  observationPeriodId     String
  // The measured value (null = "unknown" — Blueprint §1.1)
  observedValue           Decimal? @db.Decimal(20, 4)
  // R1 — origin SEPARATE FROM verification
  originType              String // "observed" | "derived" | "synthetic"
  verificationStatus      String   @default("unverified") // "unverified"|"verified"|"disputed"|"rejected"
  derivationMethod        String? // required when originType = "derived"
  sourceId                String? // FK Source (G00), required when originType = "observed"
  evidenceId              String? // FK Evidence (G00), optional
  // Demolandia flag (separate from originType) — E6
  isSynthetic             Boolean  @default(true)
  observedAt              DateTime?
  retrievedAt             DateTime @default(now())
  qualityNotes            Json     @default("{}")
  // Geographic scope (E3 + future-proofing for subnational monitoring)
  geoLevel                String   @default("national") // "national"|"sectoral"|"institutional"|"subnational"
  geoRefId                String?
  // R4 + E2 — append-only correction chain
  supersedesId            String? @unique // FK self — the previous version (unique: one successor per obs)
  supersededById          String? // FK self — the next version (set when superseded)
  correctionReason        String?
  correctedById           String?
  correctedAt             DateTime?
  isCurrent               Boolean  @default(true)
  createdBy               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  indicatorDefinition   IndicatorDefinition @relation(fields: [indicatorDefinitionId], references: [id], onDelete: Cascade)
  observationPeriod     ObservationPeriod   @relation(fields: [observationPeriodId], references: [id], onDelete: Cascade)
  strategyVersion       StrategyVersion?    @relation(fields: [strategyVersionId], references: [id])
  source                Source?             @relation(fields: [sourceId], references: [id])
  evidence              Evidence?           @relation(fields: [evidenceId], references: [id])
  // Self-relation for correction chain — supersedesId is unique (one successor per observation)
  supersedes            Observation?        @relation("ObservationChain", fields: [supersedesId], references: [id])
  supersededBy          Observation?        @relation("ObservationChain")
  varianceRecords       VarianceRecord[]

  @@index([tenantId, indicatorDefinitionId, observationPeriodId, isCurrent], map: "observations_current_idx")
  @@index([tenantId, indicatorDefinitionId, observationPeriodId, geoLevel, geoRefId, isCurrent], map: "observations_geo_current_idx")
  @@index([tenantId, supersedesId], map: "observations_supersedes_idx")
  @@map("observations")
}

model VarianceRecord {
  id                       String   @id @default(cuid())
  tenantId                 String
  strategyVersionId        String
  indicatorDefinitionId    String
  observationPeriodId      String
  // E3 + F4 — observationId is NULLABLE (null when observation is unknown)
  observationId            String?
  observationSnapshot      Json     @default("{}")
  // R2 + F4 — planned value source is structured and NULLABLE when no target
  plannedValue             Decimal? @db.Decimal(20, 4)
  plannedValueType         String   // "period_milestone"|"interim"|"final"|"none"
  plannedValueSourceKind   String?  // NULLABLE — null when plannedValueType="none" (F4)
  plannedValueSourceId     String?  // NULLABLE — null when plannedValueType="none" (F4)
  plannedValueAtPeriodId   String?
  plannedValueSnapshot     Json     @default("{}")
  // Deterministic computation (no LLM)
  varianceAbsolute         Decimal? @db.Decimal(20, 4) // null when unknown
  varianceDirection        String   // "better"|"worse"|"neutral"|"unknown"
  // R2 — comparison validity flag
  comparisonValid          Boolean
  // Blueprint §3.2 — no causal claims without evidence
  attributionLevel         String   @default("descriptive") // always "descriptive" in 02-00
  notes                    String?
  metadata                 Json     @default("{}")
  createdBy                String
  createdAt                DateTime @default(now())

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  strategyVersion     StrategyVersion     @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  indicatorDefinition IndicatorDefinition @relation(fields: [indicatorDefinitionId], references: [id], onDelete: Cascade)
  observationPeriod   ObservationPeriod   @relation(fields: [observationPeriodId], references: [id], onDelete: Cascade)
  observation         Observation?        @relation(fields: [observationId], references: [id])
  alerts              Alert[]
  // G03: reform proposals + coordinations can reference this variance record's alert
  reformProposals      ReformProposal[]
  reformCoordinationsViaVariance  ReformCoordination[] @relation("ReformCoordinationVariance")

  @@index([tenantId, strategyVersionId, observationPeriodId])
  @@index([tenantId, indicatorDefinitionId, observationPeriodId])
  @@map("variance_records")
}

model Alert {
  id                          String   @id @default(cuid())
  tenantId                    String
  strategyVersionId           String
  indicatorDefinitionId       String?
  varianceRecordId            String?
  title                       String
  description                 String
  severity                    String // "info"|"watch"|"warning"|"critical"
  // R5 — lifecycle separated from execution verification
  lifecycleStage              String   @default("detected")
  // "detected"|"notified"|"reviewed"|"decision_documented"|"closed"
  // Human decision documentation (does NOT prove execution)
  decisionDescription         String?
  decidedById                 String?
  decidedAt                   DateTime?
  // Execution verification block (separate from lifecycle)
  executionStatus             String   @default("not_applicable")
  // "not_applicable"|"pending"|"verified"|"disputed"
  // F6 — verifiedAction describes the SPECIFIC action verified (not a policy outcome)
  executionVerifiedAction     String?
  executionVerifiedAt         DateTime?
  executionVerificationSource String?
  executionVerifiedById       String?
  executionNotes              String?
  // Human sovereignty
  requiresHumanAction         Boolean  @default(true)
  createdBy                   String // "system" or userId
  reviewedBy                  String?
  reviewedAt                  DateTime?
  reviewNotes                 String?
  closedBy                    String?
  closedAt                    DateTime?
  closureReason               String?
  isAutoGenerated             Boolean  @default(false)
  metadata                    Json     @default("{}")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  strategyVersion     StrategyVersion     @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  indicatorDefinition IndicatorDefinition? @relation(fields: [indicatorDefinitionId], references: [id])
  varianceRecord     VarianceRecord?      @relation(fields: [varianceRecordId], references: [id])
  // G03: reform proposals + coordinations can reference this alert
  reformProposals      ReformProposal[]
  reformCoordinations  ReformCoordination[] @relation("ReformCoordinationAlert")

  @@index([tenantId, strategyVersionId, lifecycleStage])
  @@index([tenantId, indicatorDefinitionId])
  @@map("alerts")
}

// ============================================================
// G03 STATE REFORM (03-01) — 12 new PRIVATE tables
// ------------------------------------------------------------
// All tenant-scoped, RLS ENABLE + FORCE (see migration 0022).
// Per G03-00 FINAL PASS architecture (REV 8 — frozen):
//   - 7 core reform tables
//   - 5 coordination tables
//   - 3 helper functions (2 SECURITY INVOKER + 1 SECURITY DEFINER group)
//   - 1 dedicated role: balance_coordination_admin (NOLOGIN)
//
// Key invariants enforced by this migration:
//   C1: balance_coordination_admin has SELECT + UPDATE on participants
//       (PostgreSQL requires SELECT for WHERE clause column reads)
//   C2: set_config('app.tenant_id') is NOT a DB-level identity guarantee
//       (depends on withAuthenticatedTenant — application layer)
//   D5: Four distinct lifecycle states (approval / implementation / verification / measurement)
//   D11: Supersession preserves historical links (no silent rewrite)
//   D12: Shared snapshots support draft mode (draft → under_review → approved → revoked)
//   D15: Institutional authority separation (claimed vs verified vs participation vs approval)
// ============================================================

model ReformProposal {
  id                          String   @id @default(cuid())
  tenantId                    String
  originatingAlertId          String?
  originatingVarianceRecordId String?
  strategyVersionId           String?
  objectiveId                 String?
  coordinationId              String?
  title                       String
  problemStatement            String
  hypothesizedCauses          Json     @default("[]")
  context                     Json     @default("{}")
  status                      String   @default("draft")
  createdBy                   String
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  submittedAt                 DateTime?
  approvedAt                  DateTime?
  rejectedAt                  DateTime?
  supersededAt                DateTime?
  supersededById              String?
  archivedAt                  DateTime?
  metadata                    Json     @default("{}")

  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originatingAlert      Alert?              @relation(fields: [originatingAlertId], references: [id])
  originatingVariance   VarianceRecord?     @relation(fields: [originatingVarianceRecordId], references: [id])
  strategyVersion       StrategyVersion?    @relation(fields: [strategyVersionId], references: [id])
  objective             Objective?          @relation(fields: [objectiveId], references: [id])
  coordination          ReformCoordination? @relation(fields: [coordinationId], references: [id])
  alternatives          ReformAlternative[]
  approval              ReformApproval?
  actions               ReformAction[]
  supersededBy          ReformProposal?     @relation("ReformProposalSupersession", fields: [supersededById], references: [id])
  supersedes            ReformProposal[]    @relation("ReformProposalSupersession")
  sharedSnapshots       ReformCoordinationSharedSnapshot[]
  approvalEvents        ReformCoordinationApprovalEvent[]

  @@index([tenantId, status])
  @@index([tenantId, originatingAlertId])
  @@index([tenantId, originatingVarianceRecordId])
  @@index([tenantId, strategyVersionId])
  @@index([tenantId, objectiveId])
  @@index([tenantId, createdAt])
  @@map("reform_proposals")
}

model ReformAlternative {
  id                  String   @id @default(cuid())
  tenantId            String
  proposalId          String
  title               String
  description         String
  costEstimateMin     Decimal?  @db.Decimal(20, 2)
  costEstimateMax     Decimal?  @db.Decimal(20, 2)
  costCurrency        String   @default("USD")
  costAssumptions     Json     @default("[]")
  riskLevel           String   @default("medium")
  riskNotes           String?
  feasibilityScore    String   @default("unknown")
  feasibilityNotes    String?
  anticipatedOutcomes Json    @default("[]")
  assumptions         Json     @default("[]")
  status              String   @default("draft")
  selectedAt          DateTime?
  selectedBy          String?
  withdrawnAt         DateTime?
  withdrawnBy         String?
  withdrawalReason    String?
  draftedVia          String   @default("human")
  simulated           Boolean  @default(false)
  metadata            Json     @default("{}")
  createdBy            String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proposal   ReformProposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  approvals  ReformApproval[]
  actions    ReformAction[]

  @@unique([tenantId, proposalId, title])
  @@index([tenantId, proposalId, status])
  @@map("reform_alternatives")
}

model ReformApproval {
  id              String   @id @default(cuid())
  tenantId        String
  proposalId      String   @unique
  alternativeId   String
  approvedBy      String
  approvedAt      DateTime @default(now())
  approvalNotes   String?
  supportingEvidence Json  @default("[]")
  counterEvidence    Json  @default("[]")
  rationale       String
  metadata        Json     @default("{}")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proposal   ReformProposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  alternative ReformAlternative @relation(fields: [alternativeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, proposalId])
  @@index([tenantId, approvedAt])
  @@map("reform_approvals")
}

model ReformAction {
  id              String   @id @default(cuid())
  tenantId        String
  proposalId      String
  alternativeId   String
  programId       String?
  projectId       String?
  title           String
  description     String?
  assignedTo      String?
  assignedAt      DateTime?
  status          String   @default("planned")
  startDate       DateTime?
  dueDate         DateTime?
  completedDate   DateTime?
  cancelledDate   DateTime?
  cancelledBy     String?
  cancellationReason String?
  progressPercentage Int  @default(0)
  metadata        Json     @default("{}")
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proposal   ReformProposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  alternative ReformAlternative @relation(fields: [alternativeId], references: [id], onDelete: Cascade)
  program    Program?         @relation(fields: [programId], references: [id])
  project    Project?         @relation(fields: [projectId], references: [id])
  updates    ReformActionUpdate[]
  verification ReformVerification? @relation("ReformVerificationAction")
  feedbackLoop  ReformFeedbackLoop? @relation("ReformFeedbackLoopAction")
  sharedSnapshots ReformCoordinationSharedSnapshot[] @relation("ReformSharedSnapshotAction")

  @@index([tenantId, proposalId, status])
  @@index([tenantId, assignedTo, status])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, programId])
  @@index([tenantId, projectId])
  @@map("reform_actions")
}

model ReformActionUpdate {
  id              String   @id @default(cuid())
  tenantId        String
  actionId        String
  updateType      String
  notes           String
  progressPercentage Int?
  evidenceIds     Json     @default("[]")
  actor           String
  at              DateTime @default(now())
  metadata        Json     @default("{}")

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action  ReformAction  @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId, at])
  @@index([tenantId, at])
  @@index([tenantId, actionId, updateType])
  @@map("reform_action_updates")
}

model ReformVerification {
  id              String   @id @default(cuid())
  tenantId        String
  actionId        String   @unique
  verificationStatus String @default("pending")
  verifiedAction  String?
  evidenceSource  String?
  disputeReason   String?
  disputeEvidenceSource String?
  verifiedBy      String?
  verifiedAt      DateTime?
  notes           String?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action  ReformAction  @relation("ReformVerificationAction", fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, actionId])
  @@index([tenantId, verificationStatus])
  @@index([tenantId, verifiedAt])
  @@map("reform_verifications")
}

model ReformFeedbackLoop {
  id              String   @id @default(cuid())
  tenantId        String
  actionId        String   @unique
  beforeObservationId String?
  afterObservationId  String?
  comparisonType  String   @default("none")
  descriptiveSummary String
  attributionLevel String @default("descriptive")
  newVarianceRecordId String?
  createdBy       String
  createdAt       DateTime @default(now())
  metadata        Json     @default("{}")

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action  ReformAction  @relation("ReformFeedbackLoopAction", fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, actionId])
  @@index([tenantId, createdAt])
  @@map("reform_feedback_loops")
}

// ============================================================
// G03 COORDINATION TABLES (5 — per D6)
// ============================================================

model ReformCoordination {
  id              String   @id @default(cuid())
  leadTenantId    String
  countryId       String
  title           String
  description     String
  originatingAlertId          String?
  originatingVarianceRecordId String?
  approvalPolicy   String
  status           String   @default("draft")
  planSubmittedAt   DateTime?
  planApprovedAt    DateTime?
  planApprovedBy    String?
  activatedAt       DateTime?
  closedAt          DateTime?
  closedBy          String?
  closureReason     String?
  supersededAt      DateTime?
  supersededById    String?
  archivedAt        DateTime?
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  metadata          Json     @default("{}")

  leadTenant        Tenant              @relation(fields: [leadTenantId], references: [id], onDelete: Cascade)
  country           Country             @relation("ReformCoordinationCountry", fields: [countryId], references: [id])
  originatingAlert  Alert?              @relation("ReformCoordinationAlert", fields: [originatingAlertId], references: [id])
  originatingVariance VarianceRecord?  @relation("ReformCoordinationVariance", fields: [originatingVarianceRecordId], references: [id])
  participants      ReformCoordinationParticipant[]
  invitations       ReformCoordinationInvitation[]
  sharedSnapshots   ReformCoordinationSharedSnapshot[]
  proposals         ReformProposal[]
  approvalEvents    ReformCoordinationApprovalEvent[]
  supersededBy      ReformCoordination? @relation("CoordinationSupersession", fields: [supersededById], references: [id])
  supersedes        ReformCoordination[] @relation("CoordinationSupersession")

  @@index([leadTenantId, status])
  @@index([countryId, status])
  @@index([originatingAlertId])
  @@map("reform_coordinations")
}

model ReformCoordinationParticipant {
  id              String   @id @default(cuid())
  coordinationId  String
  tenantId        String
  institutionId   String?
  role            String   @default("contributor")
  status          String   @default("pending_invitation")
  joinedAt        DateTime?
  removedAt       DateTime?
  removedBy       String?
  removalReason   String?
  withdrawnAt     DateTime?
  withdrawalReason String?
  // B3: Institutional authority separation
  verifiedInstitutionId  String?
  verifiedAt             DateTime?
  verifiedBy             String?
  verificationMethod     String?
  verificationNotes      String?
  canApproveCommitments   Boolean  @default(false)
  approvalAuthorityGrantedBy String?
  approvalAuthorityGrantedAt DateTime?
  approvalAuthorityReason String?
  addedBy         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metadata        Json     @default("{}")

  coordination   ReformCoordination @relation(fields: [coordinationId], references: [id], onDelete: Cascade)
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([coordinationId, tenantId])
  @@index([tenantId, status])
  @@map("reform_coordination_participants")
}

model ReformCoordinationInvitation {
  id              String   @id @default(cuid())
  coordinationId  String
  invitedTenantId String
  invitedInstitutionId String?
  invitedRole     String   @default("contributor")
  status          String   @default("pending")
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedBy      String?
  declinedAt      DateTime?
  declinedBy      String?
  declinedReason  String?
  revokedAt       DateTime?
  revokedBy       String?
  revocationReason String?
  createdBy       String
  createdAt       DateTime @default(now())
  metadata        Json     @default("{}")

  coordination    ReformCoordination @relation(fields: [coordinationId], references: [id], onDelete: Cascade)

  @@index([coordinationId, status])
  @@index([invitedTenantId, status])
  @@index([expiresAt])
  @@map("reform_coordination_invitations")
}

model ReformCoordinationSharedSnapshot {
  id              String   @id @default(cuid())
  coordinationId  String
  ownerTenantId   String
  snapshotType    String
  title           String
  summary         String
  status          String   @default("draft")
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  classification  String   @default("shared_within_coordination")
  proposalId      String?
  actionId        String?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metadata        Json     @default("{}")

  coordination   ReformCoordination @relation(fields: [coordinationId], references: [id], onDelete: Cascade)
  ownerTenant    Tenant             @relation(fields: [ownerTenantId], references: [id], onDelete: Cascade)
  proposal       ReformProposal?    @relation(fields: [proposalId], references: [id])
  action         ReformAction?      @relation("ReformSharedSnapshotAction", fields: [actionId], references: [id])
  revocations    ReformCoordinationSharedSnapshotRevocation[]

  @@index([coordinationId, status])
  @@index([ownerTenantId, status])
  @@map("reform_coordination_shared_snapshots")
}

model ReformCoordinationSharedSnapshotRevocation {
  id              String   @id @default(cuid())
  tenantId        String
  coordinationId  String
  snapshotId      String
  revokedBy       String
  revokedAt       DateTime @default(now())
  reason          String
  metadata        Json     @default("{}")

  snapshot        ReformCoordinationSharedSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId])
  @@index([coordinationId])
  @@map("reform_coordination_shared_snapshot_revocations")
}

/// G03-06 Trust Boundary Closure (Migration 32):
/// The reform_coordination_snapshot_approval_requests table was dropped
/// in Migration 32. Snapshot approval is now performed via a dedicated
/// privileged DB connection (balance_snapshot_approver role) — see
/// src/lib/privileged-db.ts + src/lib/reform/coordination-service.ts
/// approveSharedSnapshot().

/// G03-06: Append-only event log for coordination approval state.
/// Each row represents ONE event (proposal_linked, approved, superseded, withdrawn).
/// No UPDATE or DELETE permitted for ANY role (verified by RLS + triggers).
/// Current approval state is DERIVED by querying the latest event per proposal
/// via the is_coordination_fully_approved() SQL function.
///
/// The `sequenceNumber` column (BIGINT GENERATED ALWAYS AS IDENTITY) provides
/// deterministic event ordering — no timestamp-tie ambiguity. The activation
/// predicate uses sequenceNumber > (strictly greater) for all ordering comparisons.
///
/// Trust boundary:
///   - balance_app: SELECT only (coordination-aware RLS — lead sees all events
///     for their coordinations; participants see only their own tenant's events).
///   - balance_coordination_admin: SELECT + INSERT only (for SECURITY DEFINER
///     trigger functions). NO UPDATE or DELETE.
///   - balance_admin: SELECT only (inspection; no modification).
///   - NO FOR ALL policy. NO UPDATE or DELETE policy for ANY role.
///   - 3 layers of protection: GRANT + RLS (FORCE) + append-only triggers.
model ReformCoordinationApprovalEvent {
  id                      String   @id @default(cuid())
  sequenceNumber          BigInt   @default(autoincrement())
  coordinationId          String
  participantTenantId     String
  proposalId              String
  eventType               String
  eventAt                 DateTime @default(now())
  eventBy                 String
  supersededByProposalId  String?
  createdAt               DateTime @default(now())
  metadata                Json     @default("{}")

  coordination            ReformCoordination @relation(fields: [coordinationId], references: [id], onDelete: Restrict)
  proposal                ReformProposal     @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  @@index([coordinationId, proposalId, sequenceNumber])
  @@index([participantTenantId, sequenceNumber])
  @@map("reform_coordination_approval_events")
}
